# Scoped to moth_ui's own headers. It used to be '.*', which linted every
# non-system header the sources pulled in -- including other modules' -- so
# moth_ui's ruleset silently governed moth_core's code and a finding there
# failed this module's build. Each module now lints what it owns.
#
# Deliberately not enabled: clang-analyzer-*, modernize-*, performance-* (not
# triaged yet), readability-magic-numbers (duplicate of the cppcoreguidelines
# one) and misc-include-cleaner (too noisy).
Checks: >
  cppcoreguidelines-*,
  readability-*,
  -readability-uppercase-literal-suffix,
  -cppcoreguidelines-non-private-member-variables-in-classes,
  -readability-identifier-length,
  -cppcoreguidelines-avoid-const-or-ref-data-members,
  -cppcoreguidelines-avoid-non-const-global-variables,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -readability-use-anyofallof,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/moth/ui/.*'
